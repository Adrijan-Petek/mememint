{
  "name": "mememint",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node ./scripts/check-platform-deps.cjs",
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "dev:hardhat": "npx hardhat node",
    "prebuild": "node ./scripts/check-platform-deps.cjs",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "prelint": "node ./scripts/check-platform-deps.cjs",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "test": "npx hardhat test",
    "lint:sol": "npx solhint contracts/**/*.sol",
    "size": "npx hardhat compile && echo 'Contract compiled successfully'",
    "slither": "slither contracts/",
    "mythril": "mythril analyze contracts/MemeMint.sol --solc-json hardhat.config.js",
    "deploy": "npx hardhat run scripts/deploy.cjs --network localhost",
    "deploy:base": "npx hardhat run scripts/deploy.cjs --network base",
    "verify:base": "echo \"Hardhat verify plugin removed to satisfy npm audit\" && exit 1"
  },
  "dependencies": {
    "@coinbase/onchainkit": "^1.1.2",
    "@farcaster/miniapp-node": "^0.1.12",
    "@farcaster/miniapp-sdk": "^0.2.1",
    "@farcaster/miniapp-wagmi-connector": "^1.1.0",
    "@niledatabase/react": "^5.1.0",
    "@niledatabase/server": "^5.1.0",
    "@openzeppelin/contracts": "^4.9.3",
    "@openzeppelin/contracts-upgradeable": "^4.9.3",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.81.5",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "mime-types": "^3.0.1",
    "next": "16.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.4",
    "viem": "^2.31.6",
    "wagmi": "^2.16.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@farcaster/quick-auth": "^0.0.7",
    "@next/eslint-plugin-next": "^15.3.4",
    "@nomicfoundation/hardhat-ethers": "^4.0.4",
    "@nomicfoundation/hardhat-mocha": "^3.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.22",
    "chai": "^4.3.10",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "hardhat": "^3.1.5",
    "hardhat-gas-reporter": "^2.3.0",
    "postcss": "^8.5.6",
    "solhint": "^6.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  },
  "overrides": {
    "cookie": "^1.1.1",
    "tmp": "^0.2.5",
    "undici": "^6.23.0"
  }
}
